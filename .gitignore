# dependencies
node_modules/

# build output (rebuilt by scripts/install.sh / npm run build)
lib/

# logs, temp, and local state
# scratch checkout for probe runs (never commit: it carries node_modules)
.probe-tree/
# registry cache used when the shared one is not writable from inside the sandbox
.npm-cache-tmp/
*.log
*.tgz
.DS_Store
coverage/

# never upload credentials or session data
.env
.env.*
*.pem
*.key
*credential*
session*.jsonl*
.dsh/
sessions/

# editor/IDE
.vscode/
.idea/
docs/screenshots/*-labeled.png
docs/screenshots/*.ansi.txt
docs/screenshots/*.pango

# local publish credentials (never copy into the tree)
.config/
