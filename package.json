{
  "name": "dsh-ssh-tui",
  "version": "0.7.3",
  "description": "SSH-friendly interactive terminal TUI plugin for DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "tui",
    "terminal",
    "ssh",
    "cordis"
  ],
  "author": "cyjyyd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyjyyd/dsh-ssh-tui.git"
  },
  "homepage": "https://github.com/cyjyyd/dsh-ssh-tui#readme",
  "bugs": {
    "url": "https://github.com/cyjyyd/dsh-ssh-tui/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./settings-routes": {
      "types": "./lib/types/settings-routes.d.ts",
      "default": "./lib/settings-routes.js"
    },
    "./settings-subagent": {
      "types": "./lib/types/settings-subagent.d.ts",
      "default": "./lib/settings-subagent.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs/remote-ops.md",
    "docs/screenshots/compare.png",
    "docs/screenshots/headless.png",
    "docs/screenshots/workspace.png",
    "docs/screenshots/slow-link.gif",
    "LICENSE",
    "docs/terminals.md",
    "docs/windows.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.3-alpha.2 <0.1.6 || >=0.1.5-alpha.1 <0.1.6 || >=0.1.7-rc.1 <0.1.8",
      "dshReleases": {
        "0.1.2-rc.1": "incompatible",
        "0.1.3-alpha.1": "unknown",
        "0.1.3-alpha.2": "compatible",
        "0.1.5-alpha.1": "compatible",
        "0.1.5-alpha.2": "compatible",
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible",
        "0.1.5-rc.3": "compatible",
        "0.1.7-rc.1": "compatible"
      },
      "profiles": [
        "tui"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"tests/*.test.mjs\"",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck",
    "install:dsh": "node scripts/install.mjs",
    "install:npm": "node scripts/install-npm.mjs",
    "uninstall:dsh": "node scripts/uninstall.mjs",
    "verify:dsh": "node scripts/verify.mjs",
    "probe:home": "node scripts/probe-home.mjs --probe",
    "probe:home:drop": "node scripts/probe-home.mjs --probe --script tui-drop-probe.mjs",
    "screenshots": "npm run build && node scripts/capture-readme-frames.mjs",
    "screenshots:slow": "npm run build && node scripts/capture-slow-link.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2 || ~3.18.4",
    "commander": "^14.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.3-alpha.2 <0.1.6 || >=0.1.5-alpha.1 <0.1.6 || >=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-agent-default-model": ">=0.1.3-alpha.2 <0.1.6 || >=0.1.5-alpha.1 <0.1.6 || >=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-agent-loop": ">=0.1.3-alpha.2 <0.1.6 || >=0.1.5-alpha.1 <0.1.6 || >=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-agent-preset": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.3-alpha.2 <0.1.6 || >=0.1.5-alpha.1 <0.1.6 || >=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-cmdline": ">=0.1.3-alpha.2 <0.1.6 || >=0.1.5-alpha.1 <0.1.6 || >=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-commands": ">=0.1.3-alpha.2 <0.1.6 || >=0.1.5-alpha.1 <0.1.6 || >=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-credentials": ">=0.1.3-alpha.2 <0.1.6 || >=0.1.5-alpha.1 <0.1.6 || >=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-llm": ">=0.1.3-alpha.2 <0.1.6 || >=0.1.5-alpha.1 <0.1.6 || >=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-session": ">=0.1.3-alpha.2 <0.1.6 || >=0.1.5-alpha.1 <0.1.6 || >=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.3-alpha.2 <0.1.6 || >=0.1.5-alpha.1 <0.1.6 || >=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-settings": ">=0.1.3-alpha.2 <0.1.6 || >=0.1.5-alpha.1 <0.1.6 || >=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-subagent": ">=0.1.3-alpha.2 <0.1.6 || >=0.1.5-alpha.1 <0.1.6 || >=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-user-approval": ">=0.1.3-alpha.2 <0.1.6 || >=0.1.5-alpha.1 <0.1.6 || >=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-user-questions": ">=0.1.3-alpha.2 <0.1.6 || >=0.1.5-alpha.1 <0.1.6 || >=0.1.7-rc.1 <0.1.8"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-preset": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset-registry": {
