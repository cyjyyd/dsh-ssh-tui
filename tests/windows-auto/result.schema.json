{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cyjyyd/dsh-ssh-tui/tests/windows-auto/result.schema.json",
  "title": "REL085-WIN-AUTO/v1 result",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "runner", "candidate", "runs"],
  "properties": {
    "contract_version": {"const": "REL085-WIN-AUTO/v1"},
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "machine", "utc_start", "utc_end", "session_id"],
      "properties": {
        "os": {"type": "string"},
        "machine": {"type": "string"},
        "utc_start": {"type": "string", "format": "date-time"},
        "utc_end": {"type": "string", "format": "date-time"},
        "session_id": {"type": "integer", "minimum": 0},
        "windows_version": {"type": "string"},
        "desktop_unlocked": {"type": "boolean"},
        "node": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relay_sha", "relay_tarball_sha256"],
      "properties": {
        "relay_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "relay_tarball_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "runs": {
      "type": "array",
      "items": {"$ref": "#/$defs/run"}
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id", "host", "terminal", "mode", "status",
        "started_at", "finished_at", "assertions", "evidence",
        "cleanup"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "host": {"enum": ["0.2.1-rc.5", "0.2.2-rc.1"]},
        "terminal": {
          "enum": ["conhost", "windows-terminal", "posix-ssh-pty"]
        },
        "mode": {
          "enum": ["REAL_GUI", "SIMULATED_CONPTY", "REAL_SSH_NETWORK"]
        },
        "status": {
          "enum": ["PASS", "FAIL", "SKIP", "NOT_MEASURED", "BLOCKED_ENV"]
        },
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "assertions": {
          "type": "array",
          "items": {"$ref": "#/$defs/assertion"}
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {"enum": ["PASS", "FAIL", "SKIP", "NOT_RUN"]},
            "notes": {"type": "string"}
          }
        },
        "failure_attribution": {
          "enum": ["PRODUCT_DEFECT", "AUTOMATION_DEFECT", "INFRA", "BLOCKED_ENV", "UNKNOWN"]
        },
        "error": {"type": "string"},
        "window": {"$ref": "#/$defs/window"},
        "ime": {"$ref": "#/$defs/ime"},
        "host_state": {"$ref": "#/$defs/host_state"},
        "notes": {"type": "string"}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "expected", "actual", "passed"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "expected": {},
        "actual": {},
        "passed": {"type": "boolean"},
        "detail": {"type": "string"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {
          "enum": ["json", "log", "screenshot", "clipboard", "hwnd", "uia", "ime_state", "session_log", "tcp_state"]
        },
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "description": {"type": "string"}
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hwnd", "window_class", "window_title", "pid", "process_name", "visible", "window_rect", "terminal_kind"],
      "properties": {
        "hwnd": {"type": "string", "minLength": 1},
        "window_class": {"type": "string", "minLength": 1},
        "window_title": {"type": "string"},
        "pid": {"type": "integer", "minimum": 1},
        "process_name": {"type": "string"},
        "visible": {"type": "boolean"},
        "window_rect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "top", "right", "bottom"],
          "properties": {
            "left": {"type": "integer"},
            "top": {"type": "integer"},
            "right": {"type": "integer"},
            "bottom": {"type": "integer"}
          }
        },
        "terminal_kind": {"enum": ["conhost", "windows-terminal", "other"]},
        "process_ancestry": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "name", "composition_active"],
      "properties": {
        "enabled": {"type": "boolean"},
        "name": {"type": "string"},
        "composition_active": {"type": "boolean"},
        "preedit": {"type": "string"},
        "committed": {"type": "string"}
      }
    },
    "host_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "alive", "session_state"],
      "properties": {
        "pid": {"type": "integer", "minimum": 1},
        "alive": {"type": "boolean"},
        "session_state": {"type": "string"},
        "tcp_state": {"type": "string"},
        "fin_or_rst": {"type": "boolean"}
      }
    }
  }
}
